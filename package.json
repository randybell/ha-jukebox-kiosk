{
  "name": "ha-jukebox-kiosk",
  "version": "0.7.12",
  "description": "Jukebox Kiosk: Home Assistant integration + bundled Jukebox Card, a kiosk jukebox for Music Assistant (Now Playing, Browse, Search, Queue, Lyrics, Speakers)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/randybell/ha-jukebox-kiosk.git"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "build": "rollup -c && node scripts/copy-fonts.mjs",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && node scripts/run-tests.mjs unit && node scripts/run-tests.mjs e2e",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:e2e": "node scripts/run-tests.mjs e2e",
    "test:fit": "node scripts/run-tests.mjs fit",
    "perf": "node test/perf.mjs 3",
    "shots": "node tools/screenshots/shots-m2.mjs"
  },
  "author": "Randy Bell",
  "license": "MIT",
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "puppeteer-core": "^25.16.0",
    "rollup": "^4.67.2",
    "tslib": "^2.9.1",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "music-assistant",
    "hacs",
    "jukebox"
  ]
}
